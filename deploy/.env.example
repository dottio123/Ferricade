# Required: release tag of the published ferricade image.
FERRICADE_VERSION=2.2.0
# Required: generate with openssl rand -base64 32 and keep it; a new key locks out every second factor because this encrypts TOTP and SSO secrets.
SECRET_KEY=
# Required: https URL of your reverse proxy, or http://<host>:21120 with ALLOW_HTTP=1 (LAN only)
PUBLIC_URL=
# Required: generate with openssl rand -hex 24 (letters and digits only:
# it goes into a URL); keep it for the database volume.
POSTGRES_PASSWORD=

# Reverse proxy: bind the admin listener on the host; loopback suits a proxy on this host.
ADMIN_BIND=127.0.0.1
# Reverse proxy: host port the HTTPS proxy connects to.
FERRICADE_ADMIN_PORT=21120
# LAN-only installs without a reverse proxy: set ALLOW_HTTP=1, PUBLIC_URL to
# http://<host IP>:21120, and ADMIN_BIND=0.0.0.0 (or the host's LAN IP) to reach
# it from other machines. Traffic, including logins, is unencrypted; never use
# this on the internet.
# ALLOW_HTTP=1
# Reverse proxy: its own address as ferricade sees it, as one /32; see README Production.
TRUSTED_PROXIES=

# These three settings go together to run RustDesk's servers in this project:
# COMPOSE_PROFILES=rustdesk
# RELAY_HOST=                 # This machine's LAN IP or DNS name clients reach; never a container name like hbbr or hbbs.
# HBBS_ADDR=hbbs:21115
# Otherwise set HBBS_ADDR to your existing hbbs address, never 127.0.0.1.
HBBS_ADDR=
# RustDesk server: this machine's LAN IP or DNS name clients reach; never a container name like hbbr or hbbs.
RELAY_HOST=
# RustDesk client API: keep 21114 because clients derive this port.
FERRICADE_CLIENT_PORT=21114

# Optional: maximum pending devices (default 500); unknown devices are not recorded at the limit.
MAX_PENDING_DEVICES=
# Optional: log level (debug, info, warn, error; default info) and format (text, json; default text).
# LOG_LEVEL=info
# LOG_FORMAT=text
