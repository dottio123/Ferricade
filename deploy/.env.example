# Required: release tag of the published ferricade image.
FERRICADE_VERSION=2.1.1
# Required: generate with openssl rand -base64 32 and keep it; a new key locks out every second factor because this encrypts TOTP and SSO secrets.
SECRET_KEY=
# Required: https URL of your reverse proxy, without a trailing slash.
PUBLIC_URL=
# Required: generate with openssl rand -hex 24 (letters and digits only:
# it goes into a URL); keep it for the database volume.
POSTGRES_PASSWORD=

# Reverse proxy: bind the admin listener on the host; loopback suits a proxy on this host.
ADMIN_BIND=127.0.0.1
# Reverse proxy: host port the HTTPS proxy connects to.
FERRICADE_ADMIN_PORT=21120
# Reverse proxy: its own address as ferricade sees it, as one /32; see README Production.
TRUSTED_PROXIES=

# RustDesk server: hbbs:21115 with compose.rustdesk.yml; otherwise your hbbs address, never 127.0.0.1.
HBBS_ADDR=
# RustDesk server: address clients use to reach hbbr, required only with compose.rustdesk.yml.
RELAY_HOST=
# RustDesk client API: keep 21114 because clients derive this port.
FERRICADE_CLIENT_PORT=21114

# Optional: maximum pending devices (default 500); unknown devices are not recorded at the limit.
MAX_PENDING_DEVICES=
# Optional: log level (debug, info, warn, error; default info) and format (text, json; default text).
# LOG_LEVEL=info
# LOG_FORMAT=text
